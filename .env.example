# RealWorldClaw Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Backend (platform/) ──────────────────────────
# JWT signing key (required)
JWT_SECRET_KEY=change-me-to-a-random-string

# API key for service-to-service auth
RWC_API_KEY=

# API key hashing secret (required)
RWC_API_KEY_SECRET=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://realworldclaw.com

# Schema path for validator service (optional)
SCHEMA_PATH=

# Testing mode (set to 1 in CI/test)
TESTING=

# ── Auth Providers ───────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

# ── Notifications ────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_FROM=noreply@realworldclaw.com

# ── Frontend (frontend/) ─────────────────────────
# These must be prefixed with NEXT_PUBLIC_ to be available in the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Monitoring (Phase 1+) ────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Analytics (Phase 2+) ─────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Database (Phase 4 — PostgreSQL migration) ────
# DATABASE_URL=postgresql://user:pass@localhost:5432/realworldclaw
