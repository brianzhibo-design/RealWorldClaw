# Database
# Default for local development (SQLite)
DATABASE_URL=sqlite:///data/realworldclaw.db
# For PostgreSQL (docker/production), uncomment and adjust:
# DATABASE_URL=postgresql://realworldclaw:realworldclaw@localhost:5432/realworldclaw

# PostgreSQL settings (used by docker-compose)
POSTGRES_DB=realworldclaw
POSTGRES_USER=realworldclaw
POSTGRES_PASSWORD=realworldclaw
POSTGRES_PORT=5432

# Redis (optional; when unset, cache features gracefully disable)
REDIS_URL=redis://localhost:6379/0

# API Key (REQUIRED — app refuses to start without it)
RWC_API_KEY=change-me-to-a-real-secret-key

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://realworldclaw.vercel.app

# Secret key for JWT/sessions
SECRET_KEY=change-me-in-production

# JWT Secret Key (falls back to SECRET_KEY if not set)
JWT_SECRET_KEY=change-me-to-a-random-secret

# OpenTelemetry (optional; leave endpoint empty to disable export)
OTEL_SERVICE_NAME=realworldclaw-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: Fly.io sets these automatically
# FLY_APP_NAME=realworldclaw-api
# FLY_REGION=hkg
